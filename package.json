{
  "name": "lennypeters",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "biome check src",
    "test": "jest",
    "test:ci": "jest --ci --coverage --maxWorkers=2 --silent",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run lint && pnpm run typecheck && pnpm exec jest --ci --maxWorkers=2 --silent",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:prod": "E2E_TEST_URL=https://lennypeters.com playwright test",
    "test:e2e:url": "playwright test",
    "prepare": "husky",
    "format": "biome format --write --unsafe .",
    "format:check": "biome check ."
  },
  "dependencies": {
    "@testing-library/dom": "10.4.1",
    "gray-matter": "4.0.3",
    "next": "15.5.22",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-pretty-code": "0.14.5",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sass": "1.102.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "1.58.2",
    "@swc/core": "1.16.2",
    "@swc/jest": "0.2.39",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "husky": "9.1.7",
    "jest": "30.3.0",
    "jest-environment-jsdom": "30.3.0",
    "lint-staged": "17.3.0",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,css,scss,md,yml,yaml}": [
      "biome check --write --unsafe"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "sharp",
      "unrs-resolver"
    ]
  }
}
